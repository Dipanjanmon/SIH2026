# PashuRaksha AI Service — Environment Configuration
#
# Gemini Flash LLM (OPTIONAL — system works fully without it, rule-based fallback).
# Provide up to 5 keys for failover. If one hits rate-limit/quota, the next is used.
#
# Get free keys from: https://aistudio.google.com/apikey
#
# Option A: comma-separated bundle
# GEMINI_API_KEYS=key1,key2,key3

# Option B: individual keys (recommended for clarity)
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# Model (default: gemini-2.5-flash — fast, multilingual, thinking disabled for speed).
# Auth keys (AQ.* format from AI Studio) use the x-goog-api-key header automatically.
GEMINI_MODEL=gemini-2.5-flash

# Backend URL for outbreak intelligence lookups
BACKEND_URL=http://localhost:8080
